{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale (réglages) : uniquement les droits utilisés par l'interface",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    "dialog:default",
    "os:allow-locale",
    "macos-permissions:default",
    "fs:read-files",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/recordings/**/*" }]
    }
  ]
}
